{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go vet:*)",
      "Bash(go test:*)",
      "Bash(go run:*)",
      "Bash(go doc:*)",
      "Bash(go list:*)",
      "Bash(go mod download)",
      "Bash(go mod tidy:*)",
      "Bash(gofmt:*)",
      "Bash(bash scripts/verify.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git tag --points-at:*)",
      "Read(./**)",
      "Edit(./extension/**)",
      "Edit(./examples/**)",
      "Edit(./frontend/**)",
      "Edit(./scripts/**)",
      "Edit(./.claude/**)",
      "Edit(./.github/**)",
      "Edit(./README.md)",
      "Edit(./CHANGELOG.md)",
      "Edit(./CLAUDE.md)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Edit(./go.mod)",
      "Edit(./go.sum)",
      "Edit(./.gitattributes)",
      "Edit(./extension/v1/testdata/api-v1.golden)"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)"
    ]
  }
}
